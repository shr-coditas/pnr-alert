# Copy to .env and fill in. Never commit .env.
PNR=1234567890

# Departure from YOUR boarding station, local time (see your ticket). Drives the polling schedule.
DEPARTURE=2026-11-20 18:30

# Long, hard-to-guess topic; anyone who knows it can read your alerts.
NTFY_TOPIC=your-pnr-topic-change-me-8f3k29

# PNR data source. {pnr} is replaced with your PNR. Copy the URL from the provider's
# Endpoints tab (code snippet), then swap your PNR for {pnr}.
PNR_API_URL=https://YOUR-PROVIDER.p.rapidapi.com/<path-from-provider>?<param>={pnr}
PNR_API_HEADERS={"X-RapidAPI-Key": "YOUR_KEY", "X-RapidAPI-Host": "YOUR-PROVIDER.p.rapidapi.com"}

# Free plan = 100 calls/month hard limit. Keep some spare.
MONTHLY_BUDGET=90
# Calls held back for the chart windows (4h and 2h before departure), the moments that matter most.
CHART_RESERVE=15
# Check at least this often (minutes) before the chart windows. 60 = hourly. Remove for the slower default tiers.
BASE_POLL_MINUTES=60
# Chart windows (about 4h and 2h before departure) poll every this many minutes.
CHART_POLL_MINUTES=10
# How often the --loop wakes up to ask "is a check due?" (free; only real checks cost API calls).
CHECK_TICK_MINUTES=5
